# Copy to /etc/llm-router-demo/env and edit for your lab.
# Prefix for demo backend: LLM_DEMO_

# BIG-IP Virtual Server (default entry VS)
LLM_DEMO_DEFAULT_VS_HOST=172.16.30.122
LLM_DEMO_DEFAULT_VS_PORT=8000

# F5 iControl (Retry/Fallback, pool member guard)
LLM_DEMO_F5_MGMT_HOST=172.16.20.198
LLM_DEMO_F5_MGMT_USERNAME=admin
LLM_DEMO_F5_MGMT_PASSWORD=CHANGE_ME

# TBLB Scheduler (optional)
LLM_DEMO_TBLB_SCHEDULER_HOST=127.0.0.1
LLM_DEMO_TBLB_SCHEDULER_PORT=8181

# Grafana (Scene 2 — target URL may include a path, e.g. https://host:3001/dashboards)
# Login API always uses scheme://host:port/login ; redirect lands on the URL below.
LLM_DEMO_GRAFANA_URL=https://aidemo.f5se.io:3001/dashboards
# LLM_DEMO_GRAFANA_USERNAME=demo
# LLM_DEMO_GRAFANA_PASSWORD=demo
# LLM_DEMO_GRAFANA_VERIFY_TLS=false

# Demo HTTP port (also set in systemd unit; override here if needed)
# PORT=8080

# Session cookie (set true when served over HTTPS)
AUTH_COOKIE_SECURE=false

# Optional path to settings.json (default: project root settings.json)
# SETTINGS_FILE=./settings.json
