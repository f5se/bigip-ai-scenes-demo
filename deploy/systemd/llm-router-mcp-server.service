[Unit]
Description=F5 MCP Tools Insight MCP Server (Streamable HTTP / SSE)
Documentation=file:///home/myf5/bigip-ai-scenes-demo/MCP-F5-DEPLOY-GUIDE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myf5
Group=myf5
WorkingDirectory=/home/myf5/bigip-ai-scenes-demo
EnvironmentFile=-/etc/llm-router-mcp-server/env
Environment=PYTHONPATH=/home/myf5/bigip-ai-scenes-demo
Environment=PORT=9001
ExecStart=/home/myf5/bigip-ai-scenes-demo/scripts/run-mcp-server.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
